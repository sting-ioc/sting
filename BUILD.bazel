load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

package(default_visibility = ["//visibility:private"])

exports_files(
    ["LICENSE"],
    visibility = ["//tools/release:__pkg__"],
)

alias(
    name = "core",
    actual = "//core:published",
    visibility = ["//visibility:public"],
)

alias(
    name = "core-j2cl",
    actual = "//core:_core_j2cl",
    visibility = ["//visibility:public"],
)

alias(
    name = "processor",
    actual = "//processor:published_plugin",
    visibility = ["//visibility:public"],
)

alias(
    name = "processor_runtime",
    actual = "//processor:published_runtime",
    visibility = ["//visibility:public"],
)

alias(
    name = "server",
    actual = "//server:published",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "unit_tests",
    tests = [
        "//processor/src/test/java/sting/processor:all_tests",
        "//server/src/test/java/sting/server/interceptors:all_tests",
        "//tools/site/src/test/java/sting/site:all_tests",
    ],
)

test_suite(
    name = "integration_tests",
    tests = [
        "//integration-tests/src/test/java/sting/integration:all_tests",
        "//integration-tests/src/test/java/sting/integration/other:all_tests",
        "//server-integration-tests/src/test/java/sting/server/integration:all_tests",
    ],
)

test_suite(
    name = "all_tests",
    tests = [
        ":integration_tests",
        ":unit_tests",
    ],
)

java_format_check(
    name = "java_format_check",
    testonly = True,
    remediation = "tools/java_format.sh write",
    targets = [
        ":all_tests",
        "//core",
        "//doc-examples",
        "//processor",
        "//server",
        "//tools/release:maven_artifacts",
        "//tools/site:tool",
    ],
)
