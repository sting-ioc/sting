load("@rules_java//java:defs.bzl", "java_import", "java_plugin")
load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

java_import(
    name = "core",
    jars = ["//tools/release:core_jar"],
    srcjar = "//tools/release:core_sources",
    deps = ["//third_party/java:jspecify"],
)

java_import(
    name = "processor",
    jars = ["//tools/release:processor_jar"],
    srcjar = "//tools/release:processor_sources",
)

java_import(
    name = "server",
    jars = ["//tools/release:server_jar"],
    srcjar = "//tools/release:server_sources",
    deps = [
        ":core",
        "//third_party/java:jakarta_transaction_api",
    ],
)

java_plugin(
    name = "sting_processor_plugin",
    generates_api = True,
    processor_class = "sting.processor.StingProcessor",
    deps = [":processor"],
)

test_suite(
    name = "unit_tests",
    tests = [
        "//processor/src/test/java/sting/processor:all_tests",
        "//server/src/test/java/sting/server/interceptors:all_tests",
        "//tools/site/src/test/java/sting/site:all_tests",
    ],
)

test_suite(
    name = "integration_tests",
    tests = [
        "//integration-tests/src/test/java/sting/integration:all_tests",
        "//integration-tests/src/test/java/sting/integration/other:all_tests",
        "//server-integration-tests/src/test/java/sting/server/integration:all_tests",
    ],
)

test_suite(
    name = "all_tests",
    tests = [
        ":integration_tests",
        ":unit_tests",
    ],
)

java_format_check(
    name = "java_format_check",
    testonly = True,
    remediation = "tools/java_format.sh write",
    targets = [
        ":all_tests",
        "//core",
        "//doc-examples",
        "//processor",
        "//server",
        "//tools/release:maven_artifacts",
        "//tools/site:tool",
    ],
)
