load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("@rules_java//java:defs.bzl", "java_import", "java_plugin")
load("@rules_palantir_java_format//:defs.bzl", "java_format_check")

package(default_visibility = ["//visibility:private"])

exports_files(
    ["LICENSE"],
    visibility = ["//tools/release:__pkg__"],
)

java_import(
    name = "core",
    jars = ["//tools/release:core_jar"],
    srcjar = "//tools/release:core_sources",
    visibility = ["//visibility:public"],
    deps = ["//third_party/java:jspecify"],
)

java_import(
    name = "processor_runtime",
    jars = ["//tools/release:processor_jar"],
    srcjar = "//tools/release:processor_sources",
    visibility = ["//visibility:public"],
)

java_import(
    name = "server",
    jars = ["//tools/release:server_jar"],
    srcjar = "//tools/release:server_sources",
    visibility = ["//visibility:public"],
    deps = [
        ":core",
        "//third_party/java:jakarta_transaction_api",
    ],
)

java_plugin(
    name = "processor",
    generates_api = True,
    processor_class = "sting.processor.StingProcessor",
    visibility = ["//visibility:public"],
    deps = [":processor_runtime"],
)

test_suite(
    name = "unit_tests",
    tests = [
        "//processor/src/test/java/sting/processor:all_tests",
        "//server/src/test/java/sting/server/interceptors:all_tests",
        "//tools/site/src/test/java/sting/site:all_tests",
    ],
)

test_suite(
    name = "integration_tests",
    tests = [
        "//integration-tests/src/test/java/sting/integration:all_tests",
        "//integration-tests/src/test/java/sting/integration/other:all_tests",
        "//server-integration-tests/src/test/java/sting/server/integration:all_tests",
    ],
)

test_suite(
    name = "all_tests",
    tests = [
        ":integration_tests",
        ":unit_tests",
    ],
)

java_format_check(
    name = "java_format_check",
    testonly = True,
    remediation = "tools/java_format.sh write",
    targets = [
        ":all_tests",
        "//core",
        "//doc-examples",
        "//processor",
        "//server",
        "//tools/release:maven_artifacts",
        "//tools/site:tool",
    ],
)

# Compile the checked release sources once for all browser consumers.
j2cl_library(
    name = "_core_j2cl",
    srcs = ["//tools/release:core_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    deps = ["//third_party/java:jspecify-j2cl"],
)

# Keep J2CL's generated Wasm/Kotlin companion targets private.
alias(
    name = "core-j2cl",
    actual = ":_core_j2cl",
    visibility = ["//visibility:public"],
)
