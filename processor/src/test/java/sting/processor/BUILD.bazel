load("//third_party/java:rules.bzl", "java_library")
load(":test_rules.bzl", "FIXTURES", "feature", "processor_test")

java_library(
    name = "test_support",
    srcs = [
        "AbstractStingProcessorTest.java",
        "package-info.java",
    ],
    deps = [
        "//processor",
        "//third_party/java:error_prone_core",
        "//third_party/java:jspecify",
        "//third_party/java:local_proton_qa",
        "//third_party/java:nullaway",
    ],
)

java_library(
    name = "test_classes",
    testonly = True,
    srcs = [
        "StingNullabilityTest.java",
        "StingProcessorMultiStageCompilesTest.java",
        "StingProcessorRuntimeDeriveTest.java",
        "StingProcessorTest.java",
    ],
    deps = [
        ":test_support",
        "//core",
        "//processor",
        "//third_party/java:javaee_api",
        "//third_party/java:javaemul_internal_annotations",
        "//third_party/java:jspecify",
        "//third_party/java:local_proton_qa",
        "//third_party/java:testng",
    ],
)

processor_test(
    name = "model_goldens",
    size = "large",
    data = feature("fragment") + feature("injectable"),
    methods = [
        "processSuccessfulCompile",
        "nestedInjectable",
        "nestedNestedInjectable",
        "nestedFragment",
        "nestedNestedFragment",
        "typedProviderMethodSupportsMultiplePublishedServiceTypes",
        "typedProviderMethodPublishesOnlyDeclaredServiceTypes",
        "packageAccessFragmentDependency",
        "publicAccessFragmentDependency",
    ],
)

processor_test(
    name = "factory_goldens",
    data = feature("factory"),
    methods = ["processSuccessfulFactoryCompile"],
)

processor_test(
    name = "injector_goldens",
    size = "large",
    data = feature("injector"),
    methods = [
        "processSuccessfulInjectorCompile",
        "processAdditionalInjectorCompile",
        "processSuccessfulPrimitiveInteropCompile",
        "processSuccessfulOptionalRequestInjectorCompile",
        "singleIncludesInjector",
        "multipleIncludesInjector",
        "diamondIncludesInjector",
        "graphvizNameCollision",
        "InjectorIncludesInjector",
    ],
)

processor_test(
    name = "interceptor_goldens",
    size = "large",
    data = feature("interceptor") + feature(
        "interceptor",
        ["bad_input"],
    ) + [FIXTURES + "/input/org:all"],
    methods = [
        "processSuccessfulInterceptorCompile",
        "generatedInterceptorSourceAssertion",
        "aroundInvocationUsesUnmodifiableWhenJetbrainsAnnotationsPresent",
        "generatedInterceptorProxyFixture",
        "interceptorProxyDotReportContainsProxyLabels",
    ],
)

processor_test(
    name = "includes_goldens",
    data = feature("fragment") + feature("injector") + feature("integration") + feature(
        "fragment",
        ["bad_input"],
    ),
    methods = [
        "basicIncludesFragment",
        "multipleIncludesFragment",
        "crossPackageIncludeAllowedWhenFragmentIsNotLocalOnly",
        "todomvcIntegrationTest",
    ],
)

processor_test(
    name = "failed_compiles",
    size = "large",
    check_nullness = False,
    data = [FIXTURES + "/bad_input:all"],
    methods = [
        "processFailedCompile",
        "processFailedInterceptorCompile",
        "crossPackageIncludeFailsWhenFragmentIsLocalOnly",
    ],
)

processor_test(
    name = "warnings",
    size = "large",
    data = [FIXTURES + "/input:all"],
    methods = [
        "processCompileWithWarnings",
        "redundantTypedProviderMethodWarning",
        "suppressedRedundantTypedProviderMethodWarning",
        "supportedAnnotationTypesIncludeMetaAnnotations",
        "processRedundantInjectableInFragmentModel",
        "processSuppressedRedundantInjectableInFragmentModel",
        "processRedundantInjectableInInjectorModel",
        "processSuppressedRedundantInjectableInInjectorModel",
        "processFragmentIncludeCycleModel",
        "processSuppressedFragmentIncludeCycleModel",
        "processFragmentIncludeLongerCycleModel",
        "processProviderFragmentIncludeCycleModel",
        "processSuppressedProviderFragmentIncludeCycleModel",
        "processCompileWithoutWarnings",
    ],
)

processor_test(
    name = "multi_round",
    data = [
        FIXTURES + "/bad_input/com/example/injector:all",
        FIXTURES + "/input/com/example/multiround:all",
        FIXTURES + "/unresolved:all",
    ],
    methods = [
        "autodetectInjectableHasNonMatchingQualifier",
        "unresolvedInjector",
        "fragmentCreatedInLaterRound",
        "injectableCreatedInLaterRound",
    ],
)

processor_test(
    name = "formatter_failure",
    check_nullness = False,
    data = feature(
        "injectable",
        ["input"],
    ),
    methods = ["formatGeneratedSourceFailsClearlyWithoutJdkExports"],
)

processor_test(
    name = "multi_stage",
    data = feature(
        "multistage",
        ["input"],
    ),
    test_class = "sting.processor.StingProcessorMultiStageCompilesTest",
)

processor_test(
    name = "runtime_derive",
    data = [FIXTURES + "/unresolved:all"],
    test_class = "sting.processor.StingProcessorRuntimeDeriveTest",
)

test_suite(
    name = "all_tests",
    tests = [
        ":factory_goldens",
        ":failed_compiles",
        ":formatter_failure",
        ":includes_goldens",
        ":injector_goldens",
        ":interceptor_goldens",
        ":model_goldens",
        ":multi_round",
        ":multi_stage",
        ":nullability",
        ":runtime_derive",
        ":warnings",
    ],
    visibility = ["//:__pkg__"],
)

processor_test(
    name = "nullability",
    data = [],
    test_class = "sting.processor.StingNullabilityTest",
)
