load("@j2cl//build_defs:rules.bzl", "j2cl_library")
load("@rules_java//java:defs.bzl", "java_import")
load("//third_party/java:rules.bzl", "java_library")

package(default_visibility = ["//visibility:private"])

java_library(
    name = "core",
    visibility = [
        "//:__pkg__",
        "//processor/src/test/java/sting/processor:__pkg__",
        "//server/src/main/java/sting/server:__pkg__",
        "//server/src/main/java/sting/server/interceptors:__pkg__",
        "//server/src/test/java/sting/server/interceptors:__pkg__",
    ],
    exports = [
        "//core/src/main/java/sting",
        "//core/src/main/java/sting/interceptors",
    ],
)

java_import(
    name = "published",
    jars = ["//tools/release:core_jar"],
    srcjar = "//tools/release:core_sources",
    visibility = ["//:__pkg__"],
    deps = ["//third_party/java:jspecify"],
)

j2cl_library(
    name = "_core_j2cl",
    srcs = ["//tools/release:core_sources"],
    experimental_enable_jspecify_support_do_not_enable_without_jspecify_static_checking_or_you_might_cause_an_outage = True,
    visibility = ["//:__pkg__"],
    deps = ["//third_party/java:jspecify-j2cl"],
)
